POSTGRES_USER=agent_loop
POSTGRES_PASSWORD=agent_loop
POSTGRES_DB=agent_loop

REDIS_URL=redis://redis:6379/0
REDIS_EMBEDDING_QUEUE=agent_loop:embedding_jobs
AGENT_SESSION_MESSAGE_LIMIT=12
AGENT_SESSION_TTL_SECONDS=86400
AGENT_RATE_LIMIT_REQUESTS=60
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_TOKEN_BUDGET=12000
AGENT_TOOL_MAX_ROUNDS=3
AGENT_LLM_TIMEOUT_SECONDS=30
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_CANDIDATE_LIMIT=200
MEMORY_CONTEXT_MAX_CHARS=2400
MEMORY_CACHE_TTL_SECONDS=300
UPLOAD_DIR=/app/storage/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://backend:8000

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=agent_loop
MINIO_SECRET_KEY=agent_loop_password
MINIO_BUCKET=agent-loop-documents
MINIO_SECURE=false

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen3.7-max
RERANK_MODEL=qwen3-rerank
RERANK_MIN_SCORE=0.35
RERANK_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# 角色完全由服务端映射；不要从 Agent 请求体接收权限。
TOOL_DEFAULT_ROLES=user
TOOL_ROLE_ASSIGNMENTS={"demo-user":["operator","approver"]}

# 逗号分隔的 HTTPS 主机名；空值表示禁止所有 Webhook。
TOOL_WEBHOOK_ALLOWED_HOSTS=
TOOL_WEBHOOK_TIMEOUT_SECONDS=10
TOOL_WEBHOOK_MAX_RESPONSE_BYTES=65536

# Day 7：只有 sandbox service 挂载 Docker socket；此 token 绝不传入执行容器。
SANDBOX_SERVICE_URL=http://sandbox-service:8080
SANDBOX_SERVICE_TOKEN=local-sandbox-token-change-me
SANDBOX_REQUEST_TIMEOUT_SECONDS=10
SANDBOX_RUNTIME_IMAGE=python:3.13-slim
SANDBOX_EXECUTION_TIMEOUT_SECONDS=5
SANDBOX_DOCKER_API_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_NANO_CPUS=500000000
SANDBOX_PIDS_LIMIT=64
SANDBOX_WORKSPACE_TMPFS_SIZE=32m
SANDBOX_TEMP_TMPFS_SIZE=16m
SANDBOX_SHM_SIZE=16m
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MAX_CONCURRENCY=2
SANDBOX_ALLOWED_ENV_KEYS=LANG,LC_ALL,TZ,PYTHONUNBUFFERED
SANDBOX_STALE_CONTAINER_TTL_SECONDS=300
