POSTGRES_USER=agent_loop
POSTGRES_PASSWORD=agent_loop
POSTGRES_DB=agent_loop

REDIS_URL=redis://redis:6379/0
REDIS_EMBEDDING_QUEUE=agent_loop:embedding_jobs
AGENT_SESSION_MESSAGE_LIMIT=12
AGENT_SESSION_TTL_SECONDS=86400
AGENT_RATE_LIMIT_REQUESTS=60
AGENT_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_TOKEN_BUDGET=12000
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_CANDIDATE_LIMIT=200
MEMORY_CONTEXT_MAX_CHARS=2400
MEMORY_CACHE_TTL_SECONDS=300
UPLOAD_DIR=/app/storage/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://backend:8000

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=agent_loop
MINIO_SECRET_KEY=agent_loop_password
MINIO_BUCKET=agent-loop-documents
MINIO_SECURE=false

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max
RERANK_MODEL=qwen3-vl-rerank
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
